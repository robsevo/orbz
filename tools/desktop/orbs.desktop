[Desktop Entry]
Type=Application
Name=Orbz
GenericName=Your office of orbs
Comment=Chat with your orbs and see their work
Exec=@HOME@/.local/bin/orbs-open
Icon=orbs
Terminal=false
StartupNotify=true
StartupWMClass=orbs
Categories=Office;
Keywords=orbs;assistant;chat;office;
Actions=pair;phone;restart;

[Desktop Action pair]
Name=Pair this window again
Exec=@HOME@/.local/bin/orbs-open --pair

[Desktop Action phone]
Name=Open the phone door
Exec=@HOME@/.local/bin/orbs-open --phone

[Desktop Action restart]
Name=Restart the home
Exec=@HOME@/.local/bin/orbs-open --restart
